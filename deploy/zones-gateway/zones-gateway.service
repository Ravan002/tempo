[Unit]
Description=Zone access gateway
Wants=network-online.target
After=network-online.target zones-indexer-boundary.service

[Service]
User=zone-access
Group=zone-access
EnvironmentFile=/etc/zone-access/gateway.env
ExecStart=/usr/local/bin/zones-gateway --config /etc/zone-access/config.json serve
Restart=always
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/zone-access-archive
UMask=0077

[Install]
WantedBy=multi-user.target
