[Unit]
Description=Authenticated private TIDX boundary
Wants=network-online.target
After=network-online.target

[Service]
User=zone-access
Group=zone-access
EnvironmentFile=-/etc/zone-access/indexer.env
ExecStart=/usr/local/bin/zones-gateway --config /etc/zone-access/indexer-boundary.json indexer-boundary
Restart=always
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
